# ==============================================================================
# STUDYHUB ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your Supabase credentials
# ==============================================================================

# Supabase Public API (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (ONLY used in secure server environments, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (For OAuth redirects and password reset callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (10 GB Free Storage, $0 Egress/Bandwidth Fees)
# Get credentials from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ==============================================================================
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=studyhub-books
# Optional custom domain or pub domain:
# CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev
